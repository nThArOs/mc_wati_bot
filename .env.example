# ============================================================
# CONFIGURATION mc_wati_bot - ENV VARIABLES (.env.example)
# ============================================================

# Répertoire de stockage des jetons de session OAuth (isolé par bot)
AUTH_TOKENS_DIR=./tokens

# Ouverture automatique du navigateur sur la page Microsoft Device Code
AUTO_OPEN_BROWSER=true

# Clé secrète TOTP générique (optionnelle si 2FA gérée sur téléphone)
MICROSOFT_TOTP_SECRET=

# Identifiants Microsoft génériques (fallback si aucun identifiant par bot)
MICROSOFT_EMAIL=
MICROSOFT_PASSWORD=

# Identifiants spécifiques par bot (ex: ANTHO1405, NTHAROS, MOISURUNAUTRECOM)
ANTHO1405_EMAIL=
ANTHO1405_PASSWORD=
ANTHO1405_TOTP_SECRET=

# Activer l'authentification automatisée Selenium en tâche de fond (true/false)
ENABLE_HEADLESS_AUTH=false

# ============================================================
# AGENT DE CONVERSATION (LLM via Ollama)
# ============================================================

# URL du serveur Ollama local (ollama serve)
OLLAMA_HOST=http://localhost:11434

# Modèle utilisé pour la conversation (ollama pull <modele>)
OLLAMA_MODEL=llama3.1

# ============================================================
# VIEWER 3D (prismarine-viewer)
# ============================================================

# Port du viewer web (par défaut : WEB_INVENTORY_PORT + 100)
VIEWER_PORT=
